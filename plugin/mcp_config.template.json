{
  "mcpServers": {
    "ateam_memory": {
      "command": "__PYTHON__",
      "args": ["-m", "ateam.mcp_memory"],
      "env": {"PYTHONPATH": "__ATEAM_HOME__"}
    },
    "ateam_bus": {
      "command": "__PYTHON__",
      "args": ["-m", "ateam.mcp_bus"],
      "env": {"PYTHONPATH": "__ATEAM_HOME__"}
    },
    "ateam_self": {
      "command": "__PYTHON__",
      "args": ["-m", "ateam.mcp_self"],
      "env": {"PYTHONPATH": "__ATEAM_HOME__"}
    },
    "ateam_tasks": {
      "command": "__PYTHON__",
      "args": ["-m", "ateam.mcp_tasks"],
      "env": {"PYTHONPATH": "__ATEAM_HOME__"}
    }
  }
}
